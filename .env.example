# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# These values configure the LOCAL docker-compose stack. A real deployment
# sets the same variables through its own secret store — see README.md
# "Environment variables".

# ---- Database -------------------------------------------------------------
# The Postgres container is created with these on first run. If you change
# DB_USER or DB_PASSWORD after the volume exists, Postgres will NOT pick up
# the change — it only initialises a fresh data directory.
DB_NAME=household_ledger
DB_USER=household_ledger
DB_PASSWORD=

# ---- Application ----------------------------------------------------------
# Signing key for access tokens. Generate a fresh one — do not reuse the
# value from another environment, and do not commit it:
#
#   openssl rand -base64 48
#
# Must be at least 32 bytes; the application refuses to start otherwise.
JWT_SECRET=

# Host port the app is published on (container always listens on 8080).
APP_PORT=8080

# ---- Optional: first-run admin -------------------------------------------
# There is no registration endpoint. To have the stack create one household
# and one ADMIN member at startup, uncomment SPRING_PROFILES_ACTIVE and set
# both DEV_ADMIN_* values. Leave all three unset for a production-shaped run
# that creates no users.
#
# SPRING_PROFILES_ACTIVE=dev
# DEV_ADMIN_EMAIL=you@example.com
# DEV_ADMIN_PASSWORD=
